from pathlib import Path
import pandas as pd

samples_file = config.get('samples', '')
if samples_file:
    sampleInfo = pd.read_csv(samples_file)
    samples_to_merge = (sampleInfo.loc[sampleInfo.groupby('sample')
                        .unit.filter(lambda x: x.nunique() > 1).index]['sample']
                        .unique())
    SAMPLES = pd.read_csv(samples_file, comment='#')['sample'].unique()
else:
    SAMPLES = config.get('sample', [])
    sampleInfo = None

print(f"DEBUG - SAMPLES: {SAMPLES}")

rule find_phage:
    input: 
        expand("{sample}.genomad.done", sample=SAMPLES)


rule run_genomad:
    input: '{assembly}'
    output: marker = touch('{assembly}.genomad.done')
    params:
        sample=lambda wildcards: str(Path(f'{wildcards.assembly}').parent.stem),
        outdir=lambda wildcards: str(Path(f'{wildcards.assembly}').parent),
        scratch=1000,
        mem=4000,
        time=800,
        db = '/nfs/nas22/fs2202/biol_micro_sunagawa/Projects/EAN/PROPHAGE_REFSEQ_EAN/scratch/databases/genomad_db',
        qerrfile=lambda wildcards: str(Path(f'{wildcards.assembly}').parent.stem) + '.genomad.qerr',
        qoutfile=lambda wildcards: str(Path(f'{wildcards.assembly}').parent.stem) + '.genomad.qout'
    conda:
        'phage'
    log:
        log='{assembly}.genomad.log',
    threads:
        64
    shell:
        'genomad end-to-end --threads {threads} --disable-nn-classification '
        '{input} {params.outdir} {params.db} &> {log.log} '